Bootstrap: docker
From: ubuntu:26.04

%environment
    export LC_ALL=C.UTF-8
    export R_LIBS_USER=""

%post
    export DEBIAN_FRONTEND="noninteractive"
    export DEBCONF_NONINTERACTIVE_SEEN=true

    apt update -y
    apt install -y \
      wget \
      git \
      r-base-dev \
      libxml2-dev

    R -e "install.packages('remotes')"
    R -e "remotes::install_github('QMUL/poLCAParallel@package')"

%runscript
    R "$@"
