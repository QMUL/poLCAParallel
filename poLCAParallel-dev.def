Bootstrap: docker
From: ubuntu:26.04

%environment
    export LC_ALL=C.UTF-8
    export R_LIBS_USER=""

%post
    export DEBIAN_FRONTEND="noninteractive"
    export DEBCONF_NONINTERACTIVE_SEEN=true

    apt update -y
    apt install -y build-essential
    apt install -y wget
    apt install -y git
    apt install -y cmake
    apt install -y libblas-dev
    apt install -y liblapack-dev
    apt install -y gfortran
    apt install -y xz-utils

    # doxygen
    apt install -y doxygen=1.15.0+ds1-1ubuntu3
    apt install -y graphviz

    # R and renv
    apt install -y r-base=4.5.2-1ubuntu2
    R -e "install.packages('renv')"

    # required for R CMD check
    apt install -y texlive-full

    # required for dependent R packages
    apt install -y libxml2-dev
    apt install -y libssl-dev
    apt install -y libcurl4-openssl-dev
    apt install -y libicu-dev
    apt install -y libx11-dev
    apt install -y pandoc

    # clone poLCAParallel and dependencies
    cd /usr/src
    git clone https://github.com/QMUL/poLCAParallel.git
    cd poLCAParallel
    R -e "renv::restore()"

    # generate automated code
    R -e "usethis::use_namespace()"
    R -e "Rcpp::compileAttributes()"
    R -e "roxygen2::roxygenize()"

    # install poLCAParallel
    R CMD INSTALL --preclean --no-multiarch .

    doxygen

    # Catch2
    cd /usr/src
    git clone https://github.com/catchorg/Catch2.git
    cd Catch2
    git checkout v3.13.0
    cmake -B build -S .
    cmake --build build --target install

    # armadillo (stand-alone)
    cd /tmp
    wget https://sourceforge.net/projects/arma/files/armadillo-15.2.3.tar.xz
    tar -xf armadillo-15.2.3.tar.xz -C /usr/src/
    cd /usr/src/armadillo*
    cmake .
    make install

    # make C++ tests
    cd /usr/src/poLCAParallel
    mkdir build
    cd build
    cmake ..
    cmake --build .

    # required for R CMD check --as-cran
    apt install -y tidy
    R -e "install.packages('V8')"

%test
    cd /usr/src/poLCAParallel/build
    ./test_polca_parallel
    cd ..
    R -e "testthat::test_local()"
    cd /tmp
    R CMD build /usr/src/poLCAParallel
    R CMD check --as-cran poLCAParallel_*.tar.gz

%runscript
    R "$@"
