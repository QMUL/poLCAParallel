Bootstrap: docker
From: ubuntu:26.04

%environment
    export LC_ALL=C.UTF-8
    export R_LIBS_USER=""

%post
    export DEBIAN_FRONTEND="noninteractive"
    export DEBCONF_NONINTERACTIVE_SEEN=true

    # graphviz required for doxygen
    # lib*-dev and pandoc required for the dependent R packages
    # texlive and tidy required for R CMD check --as-cran

    apt update -y
    apt install -y \
      r-base-dev \
      wget \
      curl \
      git \
      cmake \
      xz-utils \
      doxygen \
      graphviz \
      libxml2-dev \
      libssl-dev \
      libcurl4-openssl-dev \
      libicu-dev \
      libx11-dev \
      pandoc \
      texlive-full \
      tidy

    R -e "install.packages('renv')"

    # clone poLCAParallel and dependencies
    cd /usr/src
    git clone https://github.com/QMUL/poLCAParallel.git
    cd poLCAParallel
    R -e "renv::restore()"

    # generate automated code
    R -e "usethis::use_namespace()"
    R -e "Rcpp::compileAttributes()"
    R -e "roxygen2::roxygenize()"

    # install poLCAParallel
    R CMD INSTALL --preclean --no-multiarch .

    doxygen

    # Catch2
    cd /usr/src
    git clone https://github.com/catchorg/Catch2.git
    cd Catch2
    git checkout v3.15.3
    cmake -B build -S .
    cmake --build build --target install

    # armadillo (stand-alone)
    cd /tmp
    wget https://sourceforge.net/projects/arma/files/armadillo-15.4.2.tar.xz
    tar -xf armadillo-15.4.2.tar.xz -C /usr/src/
    cd /usr/src/armadillo*
    cmake .
    make install

    # make C++ tests
    cd /usr/src/poLCAParallel
    mkdir build
    cd build
    cmake ..
    cmake --build .

    # required for R CMD check --as-cran
    R -e "install.packages('V8')"

%test
    cd /usr/src/poLCAParallel/build
    ./test_polca_parallel
    cd ..
    R -e "testthat::test_local()"
    cd /tmp
    R CMD build /usr/src/poLCAParallel
    R CMD check --as-cran poLCAParallel_*.tar.gz

%runscript
    R "$@"
