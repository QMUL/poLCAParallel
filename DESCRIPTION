Type: Package
Title: Polytomous Variable Latent Class Analysis Parallel
Version: 1.2.8
Authors@R: c(person(given = "Sherman",
                    family = "Lo",
                    role = c("aut", "cre"),
                    email = "s.lo@qmul.ac.uk"),
             person(given = "Drew",
